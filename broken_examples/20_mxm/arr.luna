import init_int (in int, out int);
import init_matrix (in int, out blob);
import copy_matrix (in blob, out blob);
import sum_matrix (in blob, in blob, out blob);
import mul_matrix (in blob, in blob, out blob);
import sum_matrix_elements (in blob, out int);
import sum_two_num (in int, in int, out int);

#define FG_SIZE 4
#define FG_COUNT 2

sub mxm(size, count, sum) {
	name size, count, sum, A, B, C, Ctmp, Csum, Celtmp, Celsum;

	for i=0..$FG_COUNT-1 {
		for j=0..$FG_COUNT-1 {
			init_matrix($FG_SIZE, A[i*$FG_COUNT + j]);
			init_matrix($FG_SIZE, B[i*$FG_COUNT + j]);

			for k=0..$FG_COUNT-1
				mul_matrix(A[i*$FG_SIZE+k], B[k*$FG_SIZE+j], Ctmp[k]);

			copy_matrix(Ctmp[0], Csum[0]);

			for k=1..$FG_COUNT-1
				sum_matrix(Ctmp[k], Csum[k-1], Csum[k]);

			copy_matrix(Csum[$FG_COUNT-1], C[i*$FG_COUNT+j]);
		}
	}

	for i=0..$FG_COUNT-1 {
		for j=0..$FG_COUNT-1 {
			sum_matrix_elements(C[i*$FG_COUNT+j],
				Celtmp[i * $FG_COUNT + j]);
		}
	}

	init_int(Celtmp[0], Celsum[0]);
	for i=1..$FG_COUNT * $FG_COUNT - 1 {
		sum_two_num(Celsum[i-1], Celtmp[i], Celsum[i]);
	}
	
	init_int(Celsum[$FG_COUNT * $FG_COUNT -1], sum);
}

interface "clif" main (
	"string" => int size,
	"string" => int count,
	"string" <= int sum
) on mxm;
