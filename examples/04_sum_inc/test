#!/bin/bash

INPUT="11\n5"
OUTPUT="17"

set -e

if [[ "$AZ" == "" ]]; then
	echo "\$AZ not set"
	exit 1;
fi

if [[ "$BUILD_DIR" == "" ]]; then
	echo "\$BUILD_DIR not set"
	exit 1;
fi

BD=$BUILD_DIR
FILE=`ls *.luna`

echo -e "$INPUT" | $AZ/bin/luna $FILE > "$BD/result"

# verify output
echo -e "$OUTPUT" > $BD/correct
diff $BD/correct $BD/result
