#!/bin/bash

INPUT="50\n30"
OUTPUT="749.99999999999955"

set -e

if [[ "$AZ" == "" ]]; then 
	echo "\$AZ not set"
	exit 1;
fi

if [[ "$BUILD_DIR" == "" ]]; then 
	echo "\$BUILD_DIR not set"
	exit 1;
fi

BD=$BUILD_DIR
FILE=`ls *.luna`

# reset mpi until the MPIGenerator is fixed
MPIGEN=""

echo -e "$INPUT" | $AZ/bin/luna $FILE > "$BD/result"

# verify output
echo -e "$OUTPUT" > $BD/correct
# compare the first 16 bytes only (`cmp -n` on macOS fails on files of different length)
cmp <(head -c 16 "$BD/correct") <(head -c 16 "$BD/result")
