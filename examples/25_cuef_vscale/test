#!/bin/bash

# a[i] = i, c = k * a, s = sum(c) = k * n * (n - 1) / 2
INPUT="1000\n2.5"
OUTPUT="1248750"

set -e

if [[ "$AZ" == "" ]]; then
	echo "\$AZ not set"
	exit 1;
fi

if [[ "$BUILD_DIR" == "" ]]; then
	echo "\$BUILD_DIR not set"
	exit 1;
fi

BD=$BUILD_DIR
FILE=`ls *.luna`

echo -e "$INPUT" | $AZ/bin/luna $FILE > "$BD/result"

# verify output
echo -e "$OUTPUT" > $BD/correct
diff $BD/correct $BD/result

# Exercise non-square shape declarations through the normal launch pipeline.
matrix=$(mktemp -d "$BD/transpose.XXXXXX")
trap 'rm -rf "$matrix"' EXIT
mkdir "$matrix/transpose" "$matrix/build"

cat > "$matrix/transpose.luna" <<'LUNA'
import transpose(in blob a, in int cols, out blob b);

sub matrix_transpose(a, cols, b) {
	name a, cols, b;
	transpose(a, cols, b);
}

interface "clif" main (
	"path" => blob a,
	"string" => int cols,
	"path" <= blob b
) on matrix_transpose;
LUNA

cat > "$matrix/transpose/manifest.json" <<'JSON'
{
	"type": "codefrag",
	"format": "cuef",
	"func_name": "transpose",
	"params": [
		{ "kind": "input", "format": "real64_array", "type": "blob",
			"shape": [2, { "param": 1 }] },
		{ "kind": "input", "format": "int32", "type": "int32" },
		{ "kind": "output", "format": "real64_array", "type": "blob",
			"shape": [{ "param": 1 }, 2] }
	],
	"src": ["./index.cuh", "./transpose.cu"]
}
JSON

cat > "$matrix/transpose/index.cuh" <<'CUDA'
__device__ static int input_index(int i, int cols) {
	return (i % 2) * cols + i / 2;
}
CUDA

cat > "$matrix/transpose/transpose.cu" <<'CUDA'
__device__ void transpose(int i, const double *a, int cols, double *b) {
	b[i] = a[input_index(i, cols)];
}
CUDA

python3 - "$matrix" <<'PYTHON'
from pathlib import Path
from struct import pack
from sys import argv

directory = Path(argv[1])
(directory / 'input.bin').write_bytes(pack('=6d', 1, 2, 3, 4, 5, 6))
(directory / 'expected.bin').write_bytes(pack('=6d', 1, 4, 2, 5, 3, 6))
PYTHON

printf '%s\n' "$matrix/input.bin" 3 "$matrix/output.bin" |
	BUILD_DIR="$matrix/build" "$AZ/bin/luna" "$matrix/transpose.luna" > /dev/null
cmp "$matrix/expected.bin" "$matrix/output.bin"
