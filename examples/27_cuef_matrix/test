#!/bin/bash

set -euo pipefail

: "${AZ:?Source env.sh from the LuNA repository}"
: "${BUILD_DIR:?Source env.sh from the LuNA repository}"
example_dir=$(cd -- "$(dirname -- "$0")" && pwd)
mkdir -p -- "$BUILD_DIR"
test_dir=$(cd -- "$BUILD_DIR" && pwd)

printf '%s\n' 2 3 |
	BUILD_DIR="$test_dir" "$AZ/bin/luna" "$example_dir/matrix.luna" > "$test_dir/result"

cat > "$test_dir/correct" <<'EXPECTED'
Transposed matrix (3 x 2)
1 4
2 5
3 6
Row sums
6 15
EXPECTED
diff -u "$test_dir/correct" "$test_dir/result"

# Remove files generated by the previous version of this test.
if [[ "$test_dir" == "$AZ/build/_test_27_cuef_matrix" ]]; then
	rm -f -- "$test_dir/input.bin" "$test_dir/transpose.bin" "$test_dir/row_sums.bin"
fi
