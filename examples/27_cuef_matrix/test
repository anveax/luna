#!/bin/bash

set -euo pipefail

: "${AZ:?Source env.sh from the LuNA repository}"
: "${BUILD_DIR:?Source env.sh from the LuNA repository}"
example_dir=$(cd -- "$(dirname -- "$0")" && pwd)
mkdir -p -- "$BUILD_DIR"
test_dir=$(cd -- "$BUILD_DIR" && pwd)

python3 - "$test_dir" <<'PYTHON'
from pathlib import Path
from struct import pack
from sys import argv

directory = Path(argv[1])
for name in ('transpose.bin', 'row_sums.bin', 'result'):
    (directory / name).unlink(missing_ok=True)
(directory / 'input.bin').write_bytes(pack('=6d', 1, 2, 3, 4, 5, 6))
PYTHON

printf '%s\n' "$test_dir/input.bin" 2 3 "$test_dir/transpose.bin" "$test_dir/row_sums.bin" |
	BUILD_DIR="$test_dir" "$AZ/bin/luna" "$example_dir/matrix.luna" > /dev/null

python3 - "$test_dir" > "$test_dir/result" <<'PYTHON'
from pathlib import Path
from struct import unpack
from sys import argv

directory = Path(argv[1])
transposed = unpack('=6d', (directory / 'transpose.bin').read_bytes())
row_sums = unpack('=2d', (directory / 'row_sums.bin').read_bytes())

print('Transposed matrix (3 x 2)')
for offset in range(0, len(transposed), 2):
    print(*(format(value, '.17g') for value in transposed[offset:offset + 2]))
print('Row sums')
print(*(format(value, '.17g') for value in row_sums))
PYTHON

cat > "$test_dir/correct" <<'EXPECTED'
Transposed matrix (3 x 2)
1 4
2 5
3 6
Row sums
6 15
EXPECTED
diff -u "$test_dir/correct" "$test_dir/result"
