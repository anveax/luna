import make_matrix(in int rows, in int cols, out blob a);
import transpose_and_sum(in blob a, in int rows, in int cols,
	out blob transposed, out blob row_sums);
import format_matrix(in int rows, in int cols, in blob transposed,
	in blob row_sums, out blob report);

sub summarize_matrix(rows, cols, report) {
	name rows, cols, report, a, transposed, row_sums;
	make_matrix(rows, cols, a);
	transpose_and_sum(a, rows, cols, transposed, row_sums);
	format_matrix(rows, cols, transposed, row_sums, report);
}

interface "clif" main (
	"string" => int rows,
	"string" => int cols,
	"stdout" <= blob report
) on summarize_matrix;
